{% extends 'base.html.twig' %}

{% block title %}Ваучер #{{ voucher.uuid|slice(0,8) }}{% endblock %}

{% block body %}
<div class="container">
    <h1>ВАУЧЕР</h1>

    <p>Журнал: {{ voucher.template.title }}</p>
    <p>Описание: {{ voucher.template.description }}</p>
    <p>Условия: {{ voucher.terms }}</p>
    <p>Получатель: {{ voucher.fullName }}</p>
    <p>ORCID: {{ voucher.orcid }}</p>
    <p>Действует с: {{ voucher.activeFrom|date('d.m.Y') }}</p>
    <p>Действует по: {{ voucher.activeTo|date('d.m.Y') }}</p>

    <a href="{{ path('voucher_download', {uuid: voucher.uuid}) }}" class="btn">
        Скачать PDF
    </a>
</div>
{% endblock %}